      "domain": "correct",
      "signer": "untrusted",
      "expiry": "future",
      "expect": "REVERT_BAD_RESULT"
    },
    {
      "id": "V8_TAMPERED_CREATOR",
      "label": "Tampering the recipient after signing breaks verification",
      "order": "ORDER-A",
      "eligibilityCode": 1,
      "amount": 20000000,
      "domain": "correct",
      "signer": "trusted_then_tamper_creator",
      "expiry": "future",
      "expect": "REVERT_BAD_RESULT"
    },
    {
      "id": "V9_TAMPERED_AMOUNT",
      "label": "Tampering the amount after signing breaks verification",
      "order": "ORDER-A",
      "eligibilityCode": 1,
      "amount": 20000000,
      "domain": "correct",
      "signer": "trusted_then_tamper_amount",
      "expiry": "future",
      "expect": "REVERT_BAD_RESULT"
    },
    {
      "id": "V10_INFRA_UNKNOWN",
      "label": "Infrastructure-unknown code is never payable and fails closed",
      "order": "ORDER-A",
      "eligibilityCode": 2,
      "amount": 0,
      "domain": "correct",
      "signer": "trusted",
      "expiry": "future",
      "expect": "REVERT"
    }
  ]
}
