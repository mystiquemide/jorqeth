# Copy to .env and fill values locally. Never commit the resulting .env.

# MySQL / indexer
MYSQL_ROOT_PASSWORD=
INDEXER_DB_DATABASE=indexer
INDEXER_DB_USERNAME=jorqeth
INDEXER_DB_PASSWORD=

# Flare tee-proxy signing key
FCE_PROXY_PRIVATE_KEY=

# Runtime-only tee-proxy config. Copy proxy.toml to this path and insert the
# same INDEXER_DB_PASSWORD in the [db] section of the runtime copy.
FCE_PROXY_CONFIG_PATH=./proxy.runtime.toml

# Jorqeth private merchant records. Keep the JSON only in .env/runtime config.
JORQETH_PRIVATE_RECORDS=

# Coston2 RPC
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
