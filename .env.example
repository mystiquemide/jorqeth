# Coston2 deployment
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_EXPLORER_API_KEY=
JORQETH_DEPLOYER_KEY=
JORQETH_EVALUATOR_SIGNER=

# Existing live FCE verifier, reused by the FXRP-bound campaign factory deploy script.
JORQETH_FCE_VERIFIER_ADDRESS=0xf314850e31970d8337372380D183aD17a93B7F88
# Official Coston2 FTestXRP / test FXRP token.
JORQETH_FXRP_TOKEN_ADDRESS=0x0b6A3645c240605887a5532109323A3E12273dc7

# Public web configuration, filled from deployment output
NEXT_PUBLIC_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_JORQETH_TOKEN_ADDRESS=
NEXT_PUBLIC_JORQETH_VERIFIER_ADDRESS=
NEXT_PUBLIC_JORQETH_FACTORY_ADDRESS=
NEXT_PUBLIC_JORQETH_FCE_VERIFIER_ADDRESS=
NEXT_PUBLIC_JORQETH_FCE_FACTORY_ADDRESS=
NEXT_PUBLIC_JORQETH_FCE_INSTRUCTION_SENDER_ADDRESS=
NEXT_PUBLIC_JORQETH_FCE_EXTENSION_ID=66159

# Primary FXRP path. These are public Coston2 contract addresses, not secrets.
# The application also ships with these canonical Coston2 defaults and still
# accepts environment overrides for future redeployments.
NEXT_PUBLIC_JORQETH_FXRP_TOKEN_ADDRESS=0x0b6A3645c240605887a5532109323A3E12273dc7
NEXT_PUBLIC_JORQETH_FXRP_FACTORY_ADDRESS=0xF5D10934c08955fcaCA7b1b5dAF59b99d86DEa99

# Server-only FCE result polling. Point this at the public HTTPS endpoint
# for the tee-proxy whose /action/result/{instructionId} route serves extension 66159.
JORQETH_FCE_PROXY_URL=

# Server-only disclosed-signer fallback demo configuration
JORQETH_EVALUATOR_PRIVATE_KEY=
JORQETH_PRIVATE_RECORDS_JSON=[]
